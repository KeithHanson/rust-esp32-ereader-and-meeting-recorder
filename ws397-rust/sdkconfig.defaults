# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack fields in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads
# that allocate large stack fields; or better yet - use
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# --- Waveshare ESP32-S3-ePaper-3.97 board settings -------------------------
# 16 MB flash and 8 MB OCTAL PSRAM (per Waveshare product page — module marking
# not yet read at runtime; confirm with the M1 boot banner before trusting).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# esp-idf-svc allocates via PSRAM once M6 enables it; keep malloc routable there.
CONFIG_SPIRAM_USE_MALLOC=y

# --- blocking display prototype -------------------------------------------
# A full e-paper refresh is synchronous and exceeds the task-watchdog budget.
# Keep the task watchdog off until display I/O moves to a supervised worker.
CONFIG_ESP_TASK_WDT_EN=n
